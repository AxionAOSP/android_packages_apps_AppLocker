<resources>
    <style name="BaseAppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_color</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@color/background_color</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowSplashScreenBackground">@color/background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/lock_icon</item>
    </style>
    <style name="AppTheme" parent="@style/BaseAppTheme">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
