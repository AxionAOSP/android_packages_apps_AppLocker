android_app {
    name: "AppLocker",
    manifest: "AndroidManifest.xml",

    srcs: [
        "src/**/*.kt",
    ],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    use_embedded_native_libs: true,

    optimize: {
        enabled: true,
        shrink_resources: true,
    },

    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.core_core-ktx",
        "androidx.recyclerview_recyclerview",
        "androidx.appcompat_appcompat",
        "androidx.annotation_annotation",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-process",
        "androidx.emoji2_emoji2",
        "androidx.startup_startup-runtime",
        "androidx.biometric_biometric",
        "com.google.android.material_material",
        "androidx.compose.animation_animation-core",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-core",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
    ],

    kotlincflags: [
        "-Xjvm-default=all",
        "-Xopt-in=kotlin.RequiresOptIn",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],
    
    required: [
        "privapp_whitelist_com.android.applocker",
    ],
}

prebuilt_etc {
     name: "privapp_whitelist_com.android.applocker",
     system_ext_specific: true,
     sub_dir: "permissions",
     src: "privapp_whitelist_com.android.applocker.xml",
     filename_from_src: true,
}
